# ==============================================================================
# Electric Sence — Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development, or add these variables to your
# hosting provider's dashboard (Render, Railway, Fly.io, etc.).
# NEVER commit your actual .env file or API keys to GitHub!

# Google Gemini API Key (Required for AI Chat & 3072-dim Vector Embeddings)
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (Recommended: gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# Server Port (Auto-assigned by hosting platforms like Render/Railway/Fly)
PORT=3001

# Node Environment
NODE_ENV=production

# Persistent Data Storage Directory
# For hosting platforms with persistent volumes (e.g., Render Disk at /var/data or Railway at /data):
# DATA_DIR=/var/data
# If unset, defaults to ./server/data and ./server/uploads locally
DATA_DIR=

# Administrator Passcode (Required to upload/delete documents on public deployments)
# Set a strong alphanumeric passcode for faculty access:
ADMIN_KEY=your_secure_admin_passcode_here

# Allowed CORS Origins (Optional: comma-separated list of allowed domains)
# When deployed as a single unified service (Express serving Vite dist), leave empty or '*'
CORS_ORIGIN=*

